PORT=3000
# For local Docker Compose, use: mongodb://mongodb:27017/gestionturnos
MONGODB_URI=mongodb://localhost:27017/gestionturnos
JWT_SECRET=YourSecretKeyHere
SERVICE_TOKEN=ChangeThisToARandomSharedServiceSecret
DEMO_FAILURE_ENABLED=false
DEMO_FAILURE_TOKEN=ChangeThisToARandomDemoSecret
# If using PostgreSQL for appointments locally
POSTGRES_URI=postgresql://admin:adminpassword@localhost:5432/gestionturnos_appointments

# Optional Services
BREVO_API_KEY=
EMAIL_USER=
EMAIL_PASS=
FIREBASE_SERVICE_ACCOUNT=
